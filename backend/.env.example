# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MySQL. For a local socket install use:
#   mysql://USER:PASSWORD@localhost:3306/inventory_stock_control
DATABASE_URL="mysql://root:CHANGE_ME@localhost:3306/inventory_stock_control"

# Refresh tokens are opaque random strings, not JWTs, so only one secret is needed.
# Generate it with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated origins allowed to call this API with credentials.
CORS_ORIGINS=http://localhost:5173
